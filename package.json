{
  "name": "okta-xaa-inventory-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Okta Cross-App Access (XAA) demo: chat app + agent that walks the id-JAG / access-token chain to call an inventory MCP server, visualizing every API call.",
  "scripts": {
    "dev": "concurrently --names \"server,client\" --prefix-colors \"cyan,magenta\" \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "NODE_ENV=production node server/index.js",
    "client:install": "npm --prefix client install",
    "azure:deploy": "bash scripts/azure-deploy.sh",
    "azure:destroy": "bash scripts/azure-destroy.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "jose": "^5.9.6",
    "openid-client": "^5.7.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
