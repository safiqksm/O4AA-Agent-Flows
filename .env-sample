# ─────────────────────────────────────────────────────────────
# Okta Cross-App Access (XAA) demo — environment template
# Copy to .env and fill in your real Okta values.
# ─────────────────────────────────────────────────────────────

PORT=8080
# In dev (npm run dev) set this to the Vite URL; in production use :8080.
APP_BASE_URL=http://localhost:5173
SESSION_SECRET=<32+ char random string>

# ── T1 · Chat App (user login, OIDC web app) ──
OKTA_ISSUER=https://<your-org>.oktapreview.com/oauth2/default
OKTA_CLIENT_ID=<chat app client id>
OKTA_CLIENT_SECRET=<chat app client secret>
OKTA_REDIRECT_URI=http://localhost:8080/api/callback
OKTA_SCOPES=openid profile email

# ── T2 · AI Agent (token exchange, private_key_jwt) ──
AGENT_AUTH_SERVER=https://<your-org>.oktapreview.com/oauth2/default
AGENT_CLIENT_ID=<agent id, wlp…>
AGENT_PRIVATE_KEY_FILE=./keys/agent.pem
AGENT_KID=<kid of the agent key>
XAA_SCOPES=inventory:read
# Optional resource URI indicator (omitted from the request if blank).
XAA_RESOURCE=

# ── T3 · Resource Auth Server + Agent ──
RESOURCE_AUTH_SERVER=https://<your-org>.oktapreview.com/oauth2/<resource-server-id>
RESOURCE_AUDIENCE=https://<your-org>.oktapreview.com/oauth2/<resource-server-id>
RESOURCE_CLIENT_ID=<same agent id, wlp…>
RESOURCE_SCOPES=inventory:read

# ── STS Broker flow (GitHub): token-exchange → brokered GitHub token → PRs ──
GITHUB_RESOURCE=<orn of the GitHub resource connection>
GITHUB_SCOPES=
GITHUB_OWNER=<github user or org>
GITHUB_REPO=<repository name>
# GITHUB_API_BASE_URL=https://api.github.com
GITHUB_PR_BASE=main
GITHUB_PR_HEAD=<head branch for the create-PR action>
GITHUB_PR_TITLE=Automated PR via Okta AI Agent

# ── STS Broker flow (Azure): token-exchange → brokered Graph token → Microsoft Graph ──
# Resource indicator (ORN) from the Azure Resource Connection on the AI Agent.
AZURE_RESOURCE=
# Optional 'scope' on the STS token-exchange (omitted if blank).
AZURE_SCOPES=
# GRAPH_API_BASE_URL=https://graph.microsoft.com/v1.0

# ── MCP HTTP Basic auth (T3 of Secrets / Service Account flows) ──
MCP_BASIC_USERNAME=<username the MCP validates>
MCP_BASIC_PASSWORD=<password the MCP validates>

# ── Secrets flow (T2: vaulted-secret token exchange at the ORG token endpoint) ──
SECRETS_RESOURCE=orn:okta:pam:<tenant>:secrets:<secret-id>

# ── Service Account flow ──
SERVICE_ACCOUNT_RESOURCE=orn:okta:pam:<tenant>:apps:<app>:<id>:service_accounts:<sa-id>

# ── MCP Broker flow (GitHub): token-exchange → brokered token → GitHub MCP server ──
# Resource indicator (ORN) from the MCP-server Resource Connection on the AI Agent.
MCP_GITHUB_RESOURCE=<orn of the MCP server resource connection>
# Base URL registered in Okta Directory → MCP Servers.
MCP_GITHUB_URL=<https://your-mcp-server/mcp>
# Optional 'scope' on the STS token-exchange (omitted if blank).
MCP_GITHUB_SCOPES=

# ── Debug logging (optional): 1 = one console line per captured step, with response
# bodies printed for failing steps; verbose = redacted request/response bodies for
# every step. Tokens/assertions/secrets are always masked. Blank = off.
DEBUG_FLOWS=
